# AI Agentic Reconnaissance - Environment Configuration
# Copy this file to .env and configure with your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application environment (development, staging, production)
APP_ENV=development

# Application debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# TARGET CONFIGURATION
# =============================================================================

# Default target URL for assessments (use authorized targets only)
# Example: https://sample-ai-system.local
DEFAULT_TARGET_URL=https://sample-target.local

# Target timeout in seconds
TARGET_TIMEOUT=30

# Maximum retries for failed requests
MAX_RETRIES=3

# =============================================================================
# ASSESSMENT CONFIGURATION
# =============================================================================

# Assessment scope (development, testing, production)
ASSESSMENT_SCOPE=development

# Enable/disable specific reconnaissance agents
ENABLE_RAG_RECON=false
ENABLE_MODEL_FINGERPRINT=false
ENABLE_TOOL_RECON=false
ENABLE_WORKFLOW_RECON=false

# Maximum concurrent agents
MAX_CONCURRENT_AGENTS=8

# Assessment timeout in seconds
ASSESSMENT_TIMEOUT=300

# =============================================================================
# RATE LIMITING
# =============================================================================

# Requests per second limit
RATE_LIMIT_RPS=10

# Burst size for rate limiting
RATE_LIMIT_BURST=20

# Delay between requests in milliseconds
REQUEST_DELAY_MS=100

# =============================================================================
# EVIDENCE COLLECTION
# =============================================================================

# Evidence storage path
EVIDENCE_PATH=./evidence

# Enable evidence collection (true/false)
COLLECT_EVIDENCE=true

# Evidence quality threshold (0-100)
EVIDENCE_QUALITY_THRESHOLD=50

# =============================================================================
# REPORTING
# =============================================================================

# Report output directory
REPORT_OUTPUT_DIR=./reports

# Report format (json, markdown, html)
REPORT_FORMAT=json

# Include evidence in reports (true/false)
INCLUDE_EVIDENCE=true

# =============================================================================
# SAFETY AND VALIDATION
# =============================================================================

# Enable safety validator (true/false)
ENABLE_SAFETY_VALIDATOR=true

# Enable scope validation (true/false)
ENABLE_SCOPE_VALIDATION=true

# Allowed target domains (comma-separated)
# Example: sample-target.local,test-system.local
ALLOWED_DOMAINS=sample-target.local

# Blocked target patterns (comma-separated regex patterns)
BLOCKED_PATTERNS=

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

# Agent execution timeout in seconds
AGENT_TIMEOUT=60

# Enable agent health checks (true/false)
ENABLE_AGENT_HEALTH_CHECKS=true

# Agent retry attempts
AGENT_MAX_RETRIES=2

# =============================================================================
# DATABASE (if applicable)
# =============================================================================

# Database URL (SQLite example)
# DATABASE_URL=sqlite:///./reconnaissance.db

# Database connection pool size
# DB_POOL_SIZE=5

# Database connection timeout
# DB_TIMEOUT=30

# =============================================================================
# API CONFIGURATION (if applicable)
# =============================================================================

# API base URL
# API_BASE_URL=https://api.sample-system.local

# API authentication token (never commit real tokens)
# API_TOKEN=your_api_token_here

# API timeout in seconds
# API_TIMEOUT=30

# =============================================================================
# MODEL PROVIDERS (if applicable)
# =============================================================================

# Local model provider (ollama, vllm, localai, etc.)
# MODEL_PROVIDER=sample_provider

# Model API endpoint
# MODEL_API_ENDPOINT=https://sample-model-api.local

# Model name
# MODEL_NAME=sample-model

# =============================================================================
# VECTOR DATABASE (if applicable)
# =============================================================================

# Vector database type (pinecone, weaviate, chroma, etc.)
# VECTOR_DB_TYPE=sample_db

# Vector database URL
# VECTOR_DB_URL=https://sample-vector-db.local

# Vector database API key (never commit real keys)
# VECTOR_DB_API_KEY=your_api_key_here

# =============================================================================
# MCP CONFIGURATION (if applicable)
# =============================================================================

# MCP server URL
# MCP_SERVER_URL=https://sample-mcp-server.local

# MCP protocol version
# MCP_PROTOCOL_VERSION=1.0

# MCP transport (stdio, http, websocket)
# MCP_TRANSPORT=http

# =============================================================================
# MONITORING AND TELEMETRY
# =============================================================================

# Enable telemetry (true/false)
ENABLE_TELEMETRY=false

# Telemetry endpoint
# TELEMETRY_ENDPOINT=https://sample-telemetry.local

# Enable performance metrics (true/false)
ENABLE_METRICS=true

# =============================================================================
# SECURITY
# =============================================================================

# Enable TLS verification (true/false)
VERIFY_TLS=true

# TLS certificate path (if using custom CA)
# TLS_CERT_PATH=

# Enable request signing (true/false)
ENABLE_REQUEST_SIGNING=false

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Enable development mode (true/false)
DEV_MODE=false

# Enable verbose logging (true/false)
VERBOSE=false

# Enable debug output (true/false)
DEBUG_OUTPUT=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit .env file with real values to version control
# 2. Always use authorized targets with proper written permission
# 3. Review and update security settings for production use
# 4. Keep API keys and tokens secure
# 5. Use environment-specific configuration files
# 6. Regularly rotate credentials and tokens
# 7. Follow responsible disclosure practices
# 8. Maintain audit logs of all assessments
# 9. Ensure compliance with applicable laws and regulations
# 10. Document authorization for all assessment activities

# =============================================================================
# RESPONSIBLE USE
# =============================================================================

# This framework is intended for authorized security assessment only.
# Users must obtain explicit written authorization before conducting
# any assessment activities. Unauthorized use may violate applicable
# laws and regulations.

# By using this framework, you agree to:
# - Only assess systems you own or have written permission to test
# - Follow responsible disclosure practices
# - Comply with all applicable laws and regulations
# - Maintain proper documentation of authorization
# - Respect scope limitations and boundaries
# - Report findings responsibly