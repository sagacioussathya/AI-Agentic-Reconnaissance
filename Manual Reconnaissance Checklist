## Batch Testing Scripts

### Test Multiple Endpoints
```bash
#!/bin/bash
TARGET="https://target.com"
ENDPOINTS=("/api" "/v1" "/docs" "/health" "/models")

for endpoint in "${ENDPOINTS[@]}"; do
    echo "Testing: $TARGET$endpoint"
    curl -I "$TARGET$endpoint"
    echo "---"
done
```

### Test All HTTP Methods
```bash
#!/bin/bash
TARGET="https://target.com/api/endpoint"
METHODS=("GET" "POST" "PUT" "DELETE" "PATCH" "OPTIONS" "HEAD")

for method in "${METHODS[@]}"; do
    echo "Testing: $method"
    curl -X "$method" "$TARGET"
    echo "---"
done
```

### Automated Security Header Check
```bash
#!/bin/bash
TARGET="https://target.com"
HEADERS=("Content-Security-Policy" "X-Frame-Options" "X-Content-Type-Options" "Strict-Transport-Security")

for header in "${HEADERS[@]}"; do
    echo "Checking: $header"
    curl -I "$TARGET" | grep -i "$header"
    echo "---"
done
```

